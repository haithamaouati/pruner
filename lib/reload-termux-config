#!/usr/bin/env bash

reload_settings() {
  loading_system() {
    local spinner='|/-\'
    while kill -0 "$1" 2>/dev/null
    do
      for (( i=0; i<${#spinner}; i++ ))
      do
        printf "\r%c\e[?25l" "${spinner:i:1}"
        sleep 0.1
      done
    done
    printf "\r\e[?25h"
  }
  # restore the cursor even if the user interrupts the spinner
  trap 'printf "\e[?25h"' EXIT
  (termux-reload-settings) &
  loading_system $!
  wait $!
}
