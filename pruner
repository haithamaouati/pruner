#!/data/data/com.termux/files/usr/bin/env bash
# Script name: pruner
# Author: Haitham Aouati
# Fork of the original script by Y3rw1N
# Enhanced with an fzf-powered interactive fonts & themes manager for Termux
# Designed for Android Termux environment

set -euo pipefail
trap 'printf "Error on line %s\n" "$LINENO" >&2; exit 1' ERR

# Define inline reload function if lib script is missing
reload_settings() {
  if command -v termux-reload-settings &>/dev/null; then
    termux-reload-settings
  fi
}

if [[ -f "$(dirname "$0")/lib/reload-termux-config" ]]; then
  source "$(dirname "$0")/lib/reload-termux-config"
fi

json_file="$(find "$(dirname "$0")/" -maxdepth 2 -type f -name "style.json" | head -n 1)"

# Constants
SCRIPT_VERSION="1.1"

TERMUX_DIRECTORY="$HOME/.termux"
TERMUX_FONT_PATH="$TERMUX_DIRECTORY/font.ttf"
TERMUX_THEME_PATH="$TERMUX_DIRECTORY/colors.properties"

PRUNER_DIRECTORY="$TERMUX_DIRECTORY/.pruner"
THEMES_DIRECTORY="$PRUNER_DIRECTORY/themes"
FONTS_DIRECTORY="$PRUNER_DIRECTORY/fonts"

# Colors
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[0;33m'
  CYAN=$'\033[0;36m'
  BOLD=$'\033[1m'
  CYAN_BOLD=$'\033[1;36m'
  RESET=$'\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' CYAN_BOLD='' RESET=''
fi

echoerr() {
  printf "%b\n" "$@" >&2
  exit 1
}

# Environment validation
if [[ -z "${TERMUX_VERSION:-}" && "${PREFIX:-}" != /data/data/com.termux/* ]]; then
  echoerr "[${YELLOW}!${RESET}] only for android OS with termux terminal installed"
fi

# Check for missing dependencies
for d in curl jq fzf; do
  [[ -z "$(command -v "$d")" ]] && echoerr "${d} dependency is not installed\nplease install it via: pkg install ${d}"
done

[[ ! -f "$json_file" ]] && echoerr "the download source store (style.json) was not found"

ensure_dir() {
  local dir="$1"
  [[ -d "$dir" ]] || mkdir -p "$dir"
}

validate_name() {
  [[ "$1" =~ ^[a-z0-9-]+$ ]] || echoerr "invalid name: '$1'"
}

is_valid_font() {
  local magic
  magic="$(head -c 4 "$1" | od -An -tx1 | tr -d ' \n')"
  [[ "$magic" == 00010000 || "$magic" == 74727565 || "$magic" == 4f54544f ]]
}

is_valid_theme() {
  local keys='^[[:space:]]*(foreground|background|cursor|color[0-9]+)[[:space:]]*[=:]'
  grep -qE "$keys" "$1" || return 1
  local invalid_lines
  invalid_lines="$(grep -vE '^[[:space:]]*([#!].*)?$' "$1" | grep -cvE "$keys" || true)"
  [[ "$invalid_lines" == 0 ]]
}

install_ft_files() {
  local subcommand="${1:---help}"
  local filename="${2:-}"
  local download_sources target_file tmp_file validator

  case "$subcommand" in
  -f | --font)
    download_sources="$(jq -r --arg n "$filename" '.fonts[$n]' "$json_file")"
    target_file="$FONTS_DIRECTORY/$filename.ttf"
    validator=is_valid_font
    ensure_dir "$FONTS_DIRECTORY"
    ;;
  -t | --theme)
    download_sources="$(jq -r --arg n "$filename" '.themes[$n]' "$json_file")"
    target_file="$THEMES_DIRECTORY/$filename.properties"
    validator=is_valid_theme
    ensure_dir "$THEMES_DIRECTORY"
    ;;
  *)
    echoerr "invalid option: $subcommand"
    ;;
  esac

  [[ -z "$download_sources" || "$download_sources" == "null" ]] && echoerr "This font or theme is not registered"
  [[ -e "$target_file" ]] && { printf "%s is already installed.\n" "$filename"; return 0; }

  printf "Downloading %s%s%s...\n" "$BOLD" "$filename" "$RESET"
  tmp_file="$(mktemp "${TMPDIR:-/tmp}/pruner.XXXXXX")"
  if ! curl -# -fSL --proto '=https' --tlsv1.2 --connect-timeout 10 --max-time 60 -o "$tmp_file" "$download_sources"; then
    rm -f "$tmp_file"
    echoerr "${RED}download error${RESET}: check your connection or URL availability"
  fi

  if ! "$validator" "$tmp_file"; then
    rm -f "$tmp_file"
    echoerr "${RED}invalid file${RESET}: downloaded $filename failed format verification"
  fi

  mv "$tmp_file" "$target_file"
  printf "%s%s%s %shas been downloaded successfully\n" "$BOLD" "$filename" "$RESET" "$GREEN"
}

set_ft() {
  local subcommand="${1:-}"
  local filename="${2:-}"

  case "$subcommand" in
  -f | --font)
    if [[ "$filename" == "default" ]]; then
      rm -f -- "$TERMUX_FONT_PATH"
      reload_settings
      printf "%sReset font to default%s\n" "$GREEN" "$RESET"
      return
    fi
    if [[ ! -f "$FONTS_DIRECTORY/$filename.ttf" ]]; then
      install_ft_files -f "$filename"
    fi
    ensure_dir "$TERMUX_DIRECTORY"
    cp "$FONTS_DIRECTORY/$filename.ttf" "$TERMUX_FONT_PATH"
    reload_settings
    printf "%sFont updated to '%s'%s\n" "$GREEN" "$filename" "$RESET"
    ;;
  -t | --theme)
    if [[ "$filename" == "default" ]]; then
      rm -f -- "$TERMUX_THEME_PATH"
      reload_settings
      printf "%sReset color scheme to default%s\n" "$GREEN" "$RESET"
      return
    fi
    if [[ ! -f "$THEMES_DIRECTORY/$filename.properties" ]]; then
      install_ft_files -t "$filename"
    fi
    ensure_dir "$TERMUX_DIRECTORY"
    cp "$THEMES_DIRECTORY/$filename.properties" "$TERMUX_THEME_PATH"
    reload_settings
    printf "%sTheme updated to '%s'%s\n" "$GREEN" "$filename" "$RESET"
    ;;
  *)
    echoerr "$0: $1: invalid option"
    ;;
  esac
}

remove_ft_files() {
  local subcommand="${1:-}"
  local filename="${2:-}"

  case "$subcommand" in
  -a | --all)
    rm -rf -- "${THEMES_DIRECTORY:?}"/* "${FONTS_DIRECTORY:?}"/* 2>/dev/null || true
    printf "%sAll stored fonts and themes removed successfully%s\n" "$GREEN" "$RESET"
    ;;
  -f | --font)
    validate_name "$filename"
    rm -f -- "${FONTS_DIRECTORY}/${filename}.ttf"
    printf "%sFont '%s' removed%s\n" "$GREEN" "$filename" "$RESET"
    ;;
  -t | --theme)
    validate_name "$filename"
    rm -f -- "${THEMES_DIRECTORY}/${filename}.properties"
    printf "%sTheme '%s' removed%s\n" "$GREEN" "$filename" "$RESET"
    ;;
  esac
}

# fzf Interactive UI Engine
interactive_menu() {
  while true; do
    local action
    action=$(printf "Set Theme\nSet Font\nDownload Item\nRemove Item\nReset to Defaults\nExit" | \
      fzf --height=40% --layout=reverse --prompt="Pruner > " --header="Select an Action:")

    [[ -z "$action" || "$action" == "Exit" ]] && break

    case "$action" in
    "Set Theme")
      local themes theme_choice
      themes=$(jq -r '.themes | keys | .[]' "$json_file")
      theme_choice=$(printf "%s" "$themes" | fzf --height=40% --layout=reverse --prompt="Select Theme > ")
      [[ -n "$theme_choice" ]] && set_ft -t "$theme_choice"
      ;;

    "Set Font")
      local fonts font_choice
      fonts=$(jq -r '.fonts | keys | .[]' "$json_file")
      font_choice=$(printf "%s" "$fonts" | fzf --height=40% --layout=reverse --prompt="Select Font > ")
      [[ -n "$font_choice" ]] && set_ft -f "$font_choice"
      ;;

    "Download Item")
      local category item_choice
      category=$(printf "Font\nTheme" | fzf --height=40% --layout=reverse --prompt="Download Category > ")
      if [[ "$category" == "Font" ]]; then
        item_choice=$(jq -r '.fonts | keys | .[]' "$json_file" | fzf --height=40% --layout=reverse --prompt="Download Font > ")
        [[ -n "$item_choice" ]] && install_ft_files -f "$item_choice"
      elif [[ "$category" == "Theme" ]]; then
        item_choice=$(jq -r '.themes | keys | .[]' "$json_file" | fzf --height=40% --layout=reverse --prompt="Download Theme > ")
        [[ -n "$item_choice" ]] && install_ft_files -t "$item_choice"
      fi
      ;;

    "Remove Item")
      local target_type downloaded_item
      target_type=$(printf "Downloaded Fonts\nDownloaded Themes\nAll Cache" | fzf --height=40% --layout=reverse --prompt="Remove Options > ")
      if [[ "$target_type" == "Downloaded Fonts" && -d "$FONTS_DIRECTORY" ]]; then
        downloaded_item=$(find "$FONTS_DIRECTORY" -name "*.ttf" -exec basename {} .ttf \; | fzf --height=40% --layout=reverse --prompt="Remove Font > ")
        [[ -n "$downloaded_item" ]] && remove_ft_files -f "$downloaded_item"
      elif [[ "$target_type" == "Downloaded Themes" && -d "$THEMES_DIRECTORY" ]]; then
        downloaded_item=$(find "$THEMES_DIRECTORY" -name "*.properties" -exec basename {} .properties \; | fzf --height=40% --layout=reverse --prompt="Remove Theme > ")
        [[ -n "$downloaded_item" ]] && remove_ft_files -t "$downloaded_item"
      elif [[ "$target_type" == "All Cache" ]]; then
        remove_ft_files -a
      fi
      ;;

    "Reset to Defaults")
      local reset_type
      reset_type=$(printf "Font\nTheme\nBoth" | fzf --height=40% --layout=reverse --prompt="Reset Target > ")
      [[ "$reset_type" == "Font" || "$reset_type" == "Both" ]] && set_ft -f "default"
      [[ "$reset_type" == "Theme" || "$reset_type" == "Both" ]] && set_ft -t "default"
      ;;
    esac

    echo ""
    read -rp "Press Enter to return to main menu..."
  done
}

help_message() {
  cat <<EOF
Pruner v${SCRIPT_VERSION} - Interactive Termux Fonts & Themes Manager
Maintained by: Haitham Aouati (Fork of Y3rw1N/pruner)

Interactive Mode:
  $0                      Launch fzf interactive menu

CLI Commands:
  $0 set -f <font-name>   Apply specified font (downloads if needed)
  $0 set -t <theme-name>  Apply specified theme (downloads if needed)
  $0 in -f <font-name>    Download specified font
  $0 in -t <theme-name>   Download specified theme
  $0 rem -f <font-name>  Remove stored font
  $0 rem -t <theme-name> Remove stored theme
  $0 rem -a               Remove all downloaded fonts and themes
  $0 --help               Show this help message
EOF
}

main() {
  if [[ $# -eq 0 ]]; then
    interactive_menu
    exit 0
  fi

  local command="${1:-}"
  local subcommand="${2:-}"
  local filename="${3:-}"

  case "$command" in
  in | install) install_ft_files "$subcommand" "$filename" ;;
  rem | remove) remove_ft_files "$subcommand" "$filename" ;;
  set) set_ft "$subcommand" "$filename" ;;
  --help) help_message ;;
  *) echoerr "argument not found: $1\ntype '$0 --help' for more info" ;;
  esac
}

main "$@"
exit 0
